<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vayen.rdcm.mapper.ProjectEmployeeMapper">

    <resultMap id="BaseResultMap" type="com.vayen.rdcm.entity.ProjectEmployee">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="employee_id" property="employeeId"/>
        <result column="coefficient" property="coefficient"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, project_id, employee_id, coefficient, created_at
    </sql>

    <!-- 根据项目 ID 查询关联员工 -->
    <select id="findByProjectId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project_employee
        WHERE project_id = #{projectId}
    </select>

    <!-- 根据员工 ID 查询关联项目 -->
    <select id="findByEmployeeId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project_employee
        WHERE employee_id = #{employeeId}
    </select>

    <!-- 批量插入项目 - 员工关联 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO project_employee (project_id, employee_id, coefficient)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.projectId}, #{item.employeeId}, #{item.coefficient})
        </foreach>
    </insert>

    <!-- 删除项目关联的员工 -->
    <delete id="deleteByProjectId" parameterType="long">
        DELETE FROM project_employee WHERE project_id = #{projectId}
    </delete>

</mapper>
