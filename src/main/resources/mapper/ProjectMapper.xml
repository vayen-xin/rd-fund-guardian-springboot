<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vayen.rdcm.mapper.ProjectMapper">

    <resultMap id="BaseResultMap" type="com.vayen.rdcm.entity.Project">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, start_time, end_time, status, created_by, created_at
    </sql>

    <!-- 查询所有项目 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        ORDER BY created_at DESC
    </select>

    <!-- 按状态查询项目 -->
    <select id="findByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE status = #{status}
        ORDER BY created_at DESC
    </select>

    <!-- 根据创建人查询项目 -->
    <select id="findByCreatedBy" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE created_by = #{createdBy}
        ORDER BY created_at DESC
    </select>

    <!-- 根据 ID 查询项目 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.vayen.rdcm.entity.Project" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO project (
        company_id,
        project_name,
        code,
        status,
        start_date,
        manager_name,
        manager_phone,
        description
        )
        VALUES (
        #{companyId},
        #{projectName},
        #{code},
        #{status},
        #{startDate},
        #{managerName},
        #{managerPhone},
        #{description}
        )
    </insert>

