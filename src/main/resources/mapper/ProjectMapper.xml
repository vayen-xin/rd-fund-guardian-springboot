<!--            end_time = #{endTime},-->
<!--            status = #{status}-->
<!--        WHERE id = #{id}-->
<!--    </update>-->

    <!-- 结束项目 -->
    <update id="finishProject">
        UPDATE project
        SET end_time = #{endTime},
            status = '已结束'
        WHERE id = #{id}
    </update>

    <!-- 删除项目 -->
    <delete id="delete" parameterType="long">
        DELETE FROM project WHERE id = #{id}
    </delete>

</mapper>
